// FRAGMENTO: adicione dentro de match /databases/{database}/documents.
// Preserve as regras das atividades anteriores. Não use allow read, write: if true.
function sdGoogle() {
 return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com' && request.auth.token.email is string;
}
function sdTeacher() {
 return sdGoogle() && exists(/databases/$(database)/documents/professores/$(request.auth.uid))
 && get(/databases/$(database)/documents/professores/$(request.auth.uid)).data.ativo == true;
}
function sdStage(id) { return id in ['etapa1','etapa2','etapa3','etapa4','etapa5','etapa6']; }
function sdPrevious(seq,id) {
 return id == 'etapa1'
 || id == 'etapa2' && exists(/databases/$(database)/documents/sequencias/$(seq)/alunos/$(request.auth.uid)/respostas/etapa1)
 || id == 'etapa3' && exists(/databases/$(database)/documents/sequencias/$(seq)/alunos/$(request.auth.uid)/respostas/etapa2)
 || id == 'etapa4' && exists(/databases/$(database)/documents/sequencias/$(seq)/alunos/$(request.auth.uid)/respostas/etapa3)
 || id == 'etapa5' && exists(/databases/$(database)/documents/sequencias/$(seq)/alunos/$(request.auth.uid)/respostas/etapa4)
 || id == 'etapa6' && exists(/databases/$(database)/documents/sequencias/$(seq)/alunos/$(request.auth.uid)/respostas/etapa5);
}
function sdOpen(seq,id) {
 return exists(/databases/$(database)/documents/sequencias/$(seq)/controle/estado)
 && get(/databases/$(database)/documents/sequencias/$(seq)/controle/estado).data[id] == true;
}
function sdText(v) { return v is string && v.size()>0 && v.size()<=4000; }
function sdAnswers(id,a) {
 return a is map && (
 id == 'etapa1' && a.keys().hasOnly(['q1','q2','q3','q4','q5','q6','q7','q8','q9']) && a.size()==9
 && sdText(a.q1)&&sdText(a.q2)&&sdText(a.q3)&&sdText(a.q4)&&sdText(a.q5)&&sdText(a.q6)&&sdText(a.q7)&&sdText(a.q8)&&sdText(a.q9)
 || id == 'etapa2' && a.keys().hasOnly(['q1']) && a.size()==1 && a.q1=='192.168.20.130'
 || id in ['etapa3','etapa4','etapa5'] && a.keys().hasOnly(['q1','q2','q3','q4','q5']) && a.size()==5
 && sdText(a.q1)&&sdText(a.q2)&&sdText(a.q3)&&sdText(a.q4)&&sdText(a.q5)
 || id == 'etapa6' && a.keys().hasOnly(['q1','q2','q3','q4']) && a.size()==4
 && sdText(a.q1)&&sdText(a.q2)&&sdText(a.q3)&&sdText(a.q4)
 );
}
match /professores/{uid} {
 allow get: if sdGoogle() && request.auth.uid==uid;
 allow list, create, update, delete: if false;
}
match /sequencias/{seq}/controle/estado {
 allow get: if sdGoogle();
 allow create, update: if sdTeacher()
 && request.resource.data.keys().hasOnly(['etapa1','etapa2','etapa3','etapa4','etapa5','etapa6','installed','updatedAt','authorUid'])
 && request.resource.data.etapa1 is bool && request.resource.data.etapa2 is bool && request.resource.data.etapa3 is bool
 && request.resource.data.etapa4 is bool && request.resource.data.etapa5 is bool && request.resource.data.etapa6 is bool
 && request.resource.data.installed == true && request.resource.data.authorUid==request.auth.uid
 && request.resource.data.updatedAt==request.time;
 allow list, delete: if false;
}
match /sequencias/{seq}/conteudos/{stage} {
 allow get: if sdTeacher() || sdGoogle() && sdStage(stage) && (
 exists(/databases/$(database)/documents/sequencias/$(seq)/alunos/$(request.auth.uid)/respostas/$(stage))
 || sdOpen(seq,stage) && sdPrevious(seq,stage));
 allow list: if sdTeacher();
 allow create, update: if sdTeacher() && sdStage(stage)
 && request.resource.data.keys().hasOnly(['title','instructions','kind','version','questions','videoUrl'])
 && request.resource.data.title is string && request.resource.data.title.size()<=200
 && request.resource.data.instructions is string && request.resource.data.instructions.size()<=20000
 && request.resource.data.kind in ['text','riddle','video'] && request.resource.data.version is int
 && request.resource.data.questions is list && request.resource.data.questions.size()>0 && request.resource.data.questions.size()<=15
 && request.resource.data.videoUrl is string && request.resource.data.videoUrl.size()<=2000;
 allow delete: if false;
}
match /sequencias/{seq}/alunos/{uid} {
 allow get: if sdGoogle() && (request.auth.uid==uid || sdTeacher());
 allow list: if sdTeacher();
 allow create: if sdGoogle() && request.auth.uid==uid
 && request.resource.data.keys().hasOnly(['uid','email','nome','turma','createdAt'])
 && request.resource.data.uid==uid && request.resource.data.email==request.auth.token.email
 && request.resource.data.nome is string && request.resource.data.nome.size()<=300
 && request.resource.data.turma is string && request.resource.data.turma.size()>0 && request.resource.data.turma.size()<=100
 && request.resource.data.createdAt==request.time;
 allow update,delete: if false;
 match /respostas/{stage} {
  allow read: if sdGoogle() && (request.auth.uid==uid || sdTeacher());
  allow create: if sdGoogle() && request.auth.uid==uid && sdStage(stage)
  && exists(/databases/$(database)/documents/sequencias/$(seq)/alunos/$(uid))
  && sdOpen(seq,stage) && sdPrevious(seq,stage)
  && request.resource.data.keys().hasOnly(['uid','email','stage','contentVersion','title','questions','answers','submittedAt'])
  && request.resource.data.uid==uid && request.resource.data.email==request.auth.token.email && request.resource.data.stage==stage
  && request.resource.data.title==get(/databases/$(database)/documents/sequencias/$(seq)/conteudos/$(stage)).data.title
  && request.resource.data.contentVersion==get(/databases/$(database)/documents/sequencias/$(seq)/conteudos/$(stage)).data.version
  && request.resource.data.questions==get(/databases/$(database)/documents/sequencias/$(seq)/conteudos/$(stage)).data.questions
  && sdAnswers(stage,request.resource.data.answers) && request.resource.data.submittedAt==request.time;
  allow update,delete: if false;
 }
}
match /sequencias/{seq}/observacoes/{uid} {
 allow read: if sdTeacher();
 allow create,update: if sdTeacher()
 && request.resource.data.keys().hasOnly(['texto','authorUid','authorEmail','updatedAt'])
 && request.resource.data.texto is string && request.resource.data.texto.size()<=15000
 && request.resource.data.authorUid==request.auth.uid && request.resource.data.authorEmail==request.auth.token.email
 && request.resource.data.updatedAt==request.time;
 allow delete: if false;
}
